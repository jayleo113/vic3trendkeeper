# Launcher (fallback when CMF is not used): round button + Ctrl+Shift+G. Also turns a click on the
# CMF sidebar button (com_open_window = fhc_sidebar_sgui) into our own open state.
widget = {
	name = "fhc_launcher"
	size = { 44 44 }
	parentanchor = bottom|right
	position = { -16 -190 }
	layer = windows_layer
	movable = yes
	visible = "[And(GetMetaPlayer.GetPlayedOrObservedCountry.IsValid, Not(GetGlobalVariable('fhc_hide_launcher').IsSet))]"

	state = {
		trigger_when = "[GetVariableSystem.HasValue('com_open_window', 'fhc_sidebar_sgui')]"
		on_finish = "[GetVariableSystem.Set('fhc_open', 'yes')]"
		on_finish = "[GetVariableSystem.Clear('com_open_window')]"
	}

	button_icon_round = {
		size = { 44 44 }
		tooltip = "FHC_LAUNCHER_TT"
		shortcut = "fhc_toggle"
		onclick = "[GetVariableSystem.Toggle('fhc_open')]"
		blockoverride "icon" {
			texture = "gfx/interface/icons/generic_icons/gdp.dds"
		}
		blockoverride "icon_size" {
			size = { 30 30 }
		}
	}
}

# Side panels, laid out like CMF's / vanilla information panels (left column below the top bar).
widget = {
	name = "fhc_panels"
	size = { 100% 100% }
	layer = layer_ingame_menu
	visible = "[GetMetaPlayer.GetPlayedOrObservedCountry.IsValid]"

	# own / observed country: docked left while no vanilla information panel is open
	vbox = {
		parentanchor = top|left
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin_top = 85
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			fhc_panel = {
				name = "fhc_panel_own"
				datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
				visible = "[And(GetVariableSystem.Exists('fhc_open'), Not(Or(InformationPanelBar.IsPanelOpen('budget'), Or(InformationPanelBar.IsPanelOpen('building_browser'), Or(InformationPanelBar.IsPanelOpen('character'), Or(InformationPanelBar.IsPanelOpen('compact_building_browser'), Or(InformationPanelBar.IsPanelOpen('companies'), Or(InformationPanelBar.IsPanelOpen('country_panel'), Or(InformationPanelBar.IsPanelOpen('diplomatic_overview'), Or(InformationPanelBar.IsPanelOpen('journal'), Or(InformationPanelBar.IsPanelOpen('market'), Or(InformationPanelBar.IsPanelOpen('military'), Or(InformationPanelBar.IsPanelOpen('military_formation'), Or(InformationPanelBar.IsPanelOpen('politics'), Or(InformationPanelBar.IsPanelOpen('politics_panel_change_law'), Or(InformationPanelBar.IsPanelOpen('pop_browser'), Or(InformationPanelBar.IsPanelOpen('pops_overview'), Or(InformationPanelBar.IsPanelOpen('power_bloc_panel'), Or(InformationPanelBar.IsPanelOpen('society'), Or(InformationPanelBar.IsPanelOpen('tech_tree'), InformationPanelBar.IsPanelOpen('treaty_draft_panel')))))))))))))))))))))]"
				blockoverride "animation_state_block" {
					state = {
						name = _show
						on_start = "[MapListPanelManager.CloseCurrentPanel]"
						start_sound = { soundeffect = "event:/SFX/UI/SideBar/journal" }
					}
					state = {
						name = _hide
						start_sound = { soundeffect = "event:/SFX/UI/SideBar/journal_stop" }
					}
				}
			}
			expand = {}
		}
	}

	# companion: next to the vanilla country panel, following the country shown there
	vbox = {
		parentanchor = top|left
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin_top = 85
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			widget = { size = { 613 10 } }
			fhc_panel = {
				name = "fhc_panel_companion"
				datacontext = "[CountryPanel.GetCountry]"
				visible = "[And(GetVariableSystem.Exists('fhc_open'), And(InformationPanelBar.IsPanelOpen('country_panel'), CountryPanel.GetCountry.IsValid))]"
				blockoverride "fhc_subtitle" {
					text = "FHC_TITLE_COMPANION"
				}
			}
			expand = {}
		}
	}
}
