		widget = {  # page: income
			size = { 506 300 }
			visible = "[GetVariableSystem.HasValue('fhc_metric', 'income')]"
			textbox = {
				position = { 0 0 }
				autoresize = yes
				fontsize = 14
				visible = "[Country.MakeScope.Var('fhc_income_max').IsSet]"
				raw_text = "[Localize('FHC_FIRST')] #v [Country.MakeScope.Var('fhc_income_first').GetValue|K]#!　[Localize('FHC_MAX')] #v [Country.MakeScope.Var('fhc_income_max').GetValue|K]#!　[Localize('FHC_LATEST')] #v [Country.MakeScope.Var('fhc_income_last').GetValue|K]#!"
			}
			textbox = {
				position = { 0 21 }
				autoresize = yes
				fontsize = 13
				visible = "[And(Country.MakeScope.Var('fhc_income_prev').IsSet, GreaterThan_CFixedPoint(Country.MakeScope.Var('fhc_income_prev').GetValue, '(CFixedPoint)0'))]"
				raw_text = "[Localize('FHC_YOY')] [Divide_CFixedPoint(Subtract_CFixedPoint(Country.MakeScope.Var('fhc_income_last').GetValue, Country.MakeScope.Var('fhc_income_prev').GetValue), Country.MakeScope.Var('fhc_income_prev').GetValue)|+=1%]"
			}
			textbox = {
				position = { 200 21 }
				autoresize = yes
				fontsize = 13
				visible = "[And(Country.MakeScope.Var('fhc_income_first').IsSet, GreaterThan_CFixedPoint(Country.MakeScope.Var('fhc_income_first').GetValue, '(CFixedPoint)0'))]"
				raw_text = "[Localize('FHC_SINCE_FIRST')] [Divide_CFixedPoint(Subtract_CFixedPoint(Country.MakeScope.Var('fhc_income_last').GetValue, Country.MakeScope.Var('fhc_income_first').GetValue), Country.MakeScope.Var('fhc_income_first').GetValue)|+=0%]"
