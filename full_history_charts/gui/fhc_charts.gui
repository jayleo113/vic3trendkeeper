				raw_text = "[Localize('FHC_YOY')] [Divide_CFixedPoint(Subtract_CFixedPoint(Country.MakeScope.Var('fhc_gdppc_last').GetValue, Country.MakeScope.Var('fhc_gdppc_prev').GetValue), Country.MakeScope.Var('fhc_gdppc_prev').GetValue)|+=1%]"
			}
