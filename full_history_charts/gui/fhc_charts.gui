	# A vanilla information side panel showing the charts of its datacontext country.
	type fhc_panel = default_block_window_two_lines {
		blockoverride "window_header_name" {
			raw_text = "[Country.GetName]"
		}
		blockoverride "window_header_name_line_two" {
			block "fhc_subtitle" {
				text = "FHC_TITLE"
			}
		}
		blockoverride "header_back_button" {
			onclick = "[GetVariableSystem.Clear('fhc_open')]"
		}
		blockoverride "header_close_button" {
			onclick = "[GetVariableSystem.Clear('fhc_open')]"
		}
		blockoverride "fixed_top" {
			widget = {
				size = { 520 106 }
			widget = {
				size = { 510 100 }
				button_standard = {
					position = { 0 0 }
					size = { 98 26 }
					text = "FHC_TAB_gdp"
					tooltip = "FHC_TAB_gdp_TT"
					onclick = "[GetVariableSystem.Set('fhc_metric', 'gdp')]"
				}
				widget = {
					position = { 4 26 }
					size = { 90 3 }
					visible = "[Or(GetVariableSystem.HasValue('fhc_metric', 'gdp'), Not(GetVariableSystem.Exists('fhc_metric')))]"
					background = { texture = "gfx/interface/progressbar/progressbar_white.dds" color = { 0.35 0.85 0.35 1.00 } }
				}
				button_standard = {
					position = { 102 0 }
					size = { 98 26 }
					text = "FHC_TAB_pop"
					tooltip = "FHC_TAB_pop_TT"
					onclick = "[GetVariableSystem.Set('fhc_metric', 'pop')]"
				}
				widget = {
					position = { 106 26 }
					size = { 90 3 }
					visible = "[GetVariableSystem.HasValue('fhc_metric', 'pop')]"
					background = { texture = "gfx/interface/progressbar/progressbar_white.dds" color = { 0.95 0.75 0.30 1.00 } }
