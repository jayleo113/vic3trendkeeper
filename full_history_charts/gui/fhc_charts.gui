		widget = {  # page: army
			size = { 506 300 }
			visible = "[GetVariableSystem.HasValue('fhc_metric', 'army')]"
			textbox = {
				position = { 0 0 }
				autoresize = yes
				fontsize = 14
				visible = "[Country.MakeScope.Var('fhc_army_max').IsSet]"
				raw_text = "[Localize('FHC_FIRST')] #v [Country.MakeScope.Var('fhc_army_first').GetValue|0]#!　[Localize('FHC_MAX')] #v [Country.MakeScope.Var('fhc_army_max').GetValue|0]#!　[Localize('FHC_LATEST')] #v [Country.MakeScope.Var('fhc_army_last').GetValue|0]#!"
			}
			textbox = {
				position = { 0 21 }
				autoresize = yes
				fontsize = 13
				visible = "[And(Country.MakeScope.Var('fhc_army_prev').IsSet, GreaterThan_CFixedPoint(Country.MakeScope.Var('fhc_army_prev').GetValue, '(CFixedPoint)0'))]"
				raw_text = "[Localize('FHC_YOY')] [Divide_CFixedPoint(Subtract_CFixedPoint(Country.MakeScope.Var('fhc_army_last').GetValue, Country.MakeScope.Var('fhc_army_prev').GetValue), Country.MakeScope.Var('fhc_army_prev').GetValue)|+=1%]"
			}
			textbox = {
				position = { 200 21 }
				autoresize = yes
				fontsize = 13
				visible = "[And(Country.MakeScope.Var('fhc_army_first').IsSet, GreaterThan_CFixedPoint(Country.MakeScope.Var('fhc_army_first').GetValue, '(CFixedPoint)0'))]"
				raw_text = "[Localize('FHC_SINCE_FIRST')] [Divide_CFixedPoint(Subtract_CFixedPoint(Country.MakeScope.Var('fhc_army_last').GetValue, Country.MakeScope.Var('fhc_army_first').GetValue), Country.MakeScope.Var('fhc_army_first').GetValue)|+=0%]"
			}
			textbox = {
				position = { 0 0 }
				autoresize = yes
				fontsize = 13
				visible = "[Not(Country.MakeScope.Var('fhc_army_max').IsSet)]"
				text = "FHC_NO_DATA"
			}
			textbox = {
				position = { 0 46 }
				size = { 50 16 }
				align = right|nobaseline
				fontsize = 12
				raw_text = "[Country.MakeScope.Var('fhc_army_max').GetValue|0]"
				visible = "[Country.MakeScope.Var('fhc_army_max').IsSet]"
