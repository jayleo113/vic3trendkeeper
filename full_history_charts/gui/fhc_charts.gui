		widget = {  # page: gold
			size = { 506 300 }
			visible = "[GetVariableSystem.HasValue('fhc_metric', 'gold')]"
			textbox = {
				position = { 0 0 }
				autoresize = yes
				fontsize = 14
				visible = "[Country.MakeScope.Var('fhc_gold_max').IsSet]"
				raw_text = "[Localize('FHC_FIRST')] #v [Country.MakeScope.Var('fhc_gold_first').GetValue|K]#!　[Localize('FHC_MAX')] #v [Country.MakeScope.Var('fhc_gold_max').GetValue|K]#!　[Localize('FHC_LATEST')] #v [Country.MakeScope.Var('fhc_gold_last').GetValue|K]#!"
			}
			textbox = {
				position = { 0 21 }
				autoresize = yes
				fontsize = 13
				visible = "[And(Country.MakeScope.Var('fhc_gold_prev').IsSet, GreaterThan_CFixedPoint(Country.MakeScope.Var('fhc_gold_prev').GetValue, '(CFixedPoint)0'))]"
				raw_text = "[Localize('FHC_YOY')] [Divide_CFixedPoint(Subtract_CFixedPoint(Country.MakeScope.Var('fhc_gold_last').GetValue, Country.MakeScope.Var('fhc_gold_prev').GetValue), Country.MakeScope.Var('fhc_gold_prev').GetValue)|+=1%]"
			}
			textbox = {
				position = { 200 21 }
				autoresize = yes
				fontsize = 13
				visible = "[And(Country.MakeScope.Var('fhc_gold_first').IsSet, GreaterThan_CFixedPoint(Country.MakeScope.Var('fhc_gold_first').GetValue, '(CFixedPoint)0'))]"
				raw_text = "[Localize('FHC_SINCE_FIRST')] [Divide_CFixedPoint(Subtract_CFixedPoint(Country.MakeScope.Var('fhc_gold_last').GetValue, Country.MakeScope.Var('fhc_gold_first').GetValue), Country.MakeScope.Var('fhc_gold_first').GetValue)|+=0%]"
			}
			textbox = {
				position = { 0 0 }
				autoresize = yes
				fontsize = 13
				visible = "[Not(Country.MakeScope.Var('fhc_gold_max').IsSet)]"
				text = "FHC_NO_DATA"
			}
			textbox = {
				position = { 0 46 }
				size = { 50 16 }
				align = right|nobaseline
				fontsize = 12
				raw_text = "[Country.MakeScope.Var('fhc_gold_max').GetValue|K]"
				visible = "[Country.MakeScope.Var('fhc_gold_max').IsSet]"
			}
			textbox = {
				position = { 0 153 }
				size = { 50 16 }
