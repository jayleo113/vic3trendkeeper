				raw_text = "[Multiply_CFixedPoint(Country.MakeScope.Var('fhc_gold_max').GetValue, '(CFixedPoint)0.5')|K]"
				visible = "[Country.MakeScope.Var('fhc_gold_max').IsSet]"
			}
			textbox = {
				position = { 0 260 }
				size = { 50 16 }
				align = right|nobaseline
