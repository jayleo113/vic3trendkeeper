				raw_text = "[Localize('FHC_SINCE_FIRST')] [Divide_CFixedPoint(Subtract_CFixedPoint(Country.MakeScope.Var('fhc_gdppc_last').GetValue, Country.MakeScope.Var('fhc_gdppc_first').GetValue), Country.MakeScope.Var('fhc_gdppc_first').GetValue)|+=0%]"
