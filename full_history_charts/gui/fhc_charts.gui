		widget = {  # page: infamy
			size = { 506 300 }
			visible = "[GetVariableSystem.HasValue('fhc_metric', 'infamy')]"
			textbox = {
				position = { 0 0 }
				autoresize = yes
				fontsize = 14
				visible = "[Country.MakeScope.Var('fhc_infamy_max').IsSet]"
				raw_text = "[Localize('FHC_FIRST')] #v [Country.MakeScope.Var('fhc_infamy_first').GetValue|0]#!　[Localize('FHC_MAX')] #v [Country.MakeScope.Var('fhc_infamy_max').GetValue|0]#!　[Localize('FHC_LATEST')] #v [Country.MakeScope.Var('fhc_infamy_last').GetValue|0]#!"
			}
			textbox = {
				position = { 0 21 }
				autoresize = yes
				fontsize = 13
				visible = "[And(Country.MakeScope.Var('fhc_infamy_prev').IsSet, GreaterThan_CFixedPoint(Country.MakeScope.Var('fhc_infamy_prev').GetValue, '(CFixedPoint)0'))]"
				raw_text = "[Localize('FHC_YOY')] [Divide_CFixedPoint(Subtract_CFixedPoint(Country.MakeScope.Var('fhc_infamy_last').GetValue, Country.MakeScope.Var('fhc_infamy_prev').GetValue), Country.MakeScope.Var('fhc_infamy_prev').GetValue)|+=1%]"
			}
			textbox = {
				position = { 200 21 }
				autoresize = yes
				fontsize = 13
				visible = "[And(Country.MakeScope.Var('fhc_infamy_first').IsSet, GreaterThan_CFixedPoint(Country.MakeScope.Var('fhc_infamy_first').GetValue, '(CFixedPoint)0'))]"
				raw_text = "[Localize('FHC_SINCE_FIRST')] [Divide_CFixedPoint(Subtract_CFixedPoint(Country.MakeScope.Var('fhc_infamy_last').GetValue, Country.MakeScope.Var('fhc_infamy_first').GetValue), Country.MakeScope.Var('fhc_infamy_first').GetValue)|+=0%]"
			}
			textbox = {
				position = { 0 0 }
				autoresize = yes
				fontsize = 13
				visible = "[Not(Country.MakeScope.Var('fhc_infamy_max').IsSet)]"
