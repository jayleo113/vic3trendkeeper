				raw_text = "[Localize('FHC_SINCE_FIRST')] [Divide_CFixedPoint(Subtract_CFixedPoint(Country.MakeScope.Var('fhc_navy_last').GetValue, Country.MakeScope.Var('fhc_navy_first').GetValue), Country.MakeScope.Var('fhc_navy_first').GetValue)|+=0%]"
