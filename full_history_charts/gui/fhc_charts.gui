		blockoverride "scrollarea_content" {
			fhc_chart_view = {
				parentanchor = hcenter
			}
			textbox = {
				parentanchor = hcenter
				size = { 506 40 }
				multiline = yes
				fontsize = 12
				text = "FHC_NOTE"
